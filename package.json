{
  "name": "competition-intel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.19 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --project node --project desktop",
    "test:a11y": "vitest run --project a11y",
    "audit:deps": "pnpm audit --audit-level=moderate",
    "perf:search": "tsc -b tools/perf/search && pnpm --filter @compintel/perf-search perf",
    "e2e": "pnpm --filter @compintel/desktop build && pnpm --filter @compintel/desktop e2e",
    "seed:demo": "tsc -b tools/perf/search && pnpm --filter @compintel/perf-search seed:demo",
    "gazetteer:build": "pnpm --filter @compintel/gazetteer-tools exec tsx src/build.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
