{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/.tsbuildinfo",
    // Ruling R6: the base config is Node-only, so the DOM libraries, the bundler
    // resolution Vite needs and React's JSX transform live here and nowhere else.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    // `node` is here for the test files only — `tokens.contrast.test.ts` reads
    // the token file off disk, because vitest does not process CSS. Application
    // code must stay browser-only; a `node:` import in it fails `vite build`.
    "types": ["vite/client", "node"],
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [{ "path": "../../packages/contracts" }]
}
