{
  "name": "@compintel/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/main.ts --dev",
    "start": "tsx src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "argon:cost": "tsx src/tools/argon-cost.ts",
    "bundle": "tsx src/tools/bundle.ts",
    "smoke:bundle": "pnpm bundle && tsx src/tools/smoke-bundle.ts"
  },
  "dependencies": {
    "@compintel/contracts": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@node-rs/argon2": "2.2.1",
    "age-encryption": "0.3.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "tsx": "4.23.13"
  }
}
