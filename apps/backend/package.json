{
  "name": "@compintel/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/main.ts --dev",
    "start": "tsx src/main.ts",
    "bundle": "tsx src/tools/bundle.ts",
    "smoke:bundle": "pnpm bundle && tsx src/tools/smoke-bundle.ts"
  },
  "dependencies": {
    "@compintel/contracts": "workspace:*",
    "@fastify/cors": "11.3.0",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.13"
  }
}
